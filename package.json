{
  "name": "n8n-nodes-signlift",
  "version": "0.2.1",
  "description": "n8n community node for Signlift, the eIDAS electronic signature API",
  "license": "MIT",
  "homepage": "https://doc.signlift.eu",
  "keywords": [
    "n8n-community-node-package",
    "signlift",
    "electronic-signature",
    "esignature",
    "eidas",
    "pdf"
  ],
  "author": {
    "name": "Ismael B.",
    "email": "ismael@capsens.eu"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CapSens/signlift-n8n.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/SignliftApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Signlift/Signlift.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^19.0.4",
    "typescript": "5.9.2",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "bugs": {
    "url": "https://github.com/CapSens/signlift-n8n/issues"
  }
}
